# Base URL of the Fight Calendar API. Copy this file to .env and adjust
# if you're not running the API locally on the default port.
VITE_API_BASE_URL=http://localhost:5080

# Purely cosmetic: colors the logo differently per environment so it's
# obvious at a glance which one you're looking at (blue=local, yellow=
# staging, red/gold=production - the default if unset or unrecognized).
VITE_APP_ENV=local
